{
  "name": "pdf-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:backend": "cargo run --manifest-path backend/Cargo.toml --release",
    "dev:frontend": "vite --host",
    "dev": "concurrently -k -p \"[{name}]\" -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start-server": "cargo run --manifest-path backend/Cargo.toml --release",
    "stop": "npx --yes kill-port 3001 5173 || lsof -ti:3001,5173 | xargs kill -9 2>/dev/null || true",
    "dev:all": "npm run dev",
    "build:backend": "cd backend && cargo build --release",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@pdftron/webviewer": "^11.12.0",
    "cloudmersive-convert-api-client": "^2.8.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "libreoffice-convert": "^1.8.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "pptx2json": "^0.0.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "spire.doc": "^13.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
